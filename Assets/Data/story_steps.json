            "next_step": "step_test_end_001"
          },
          {
            "choice_id": "test_opt_b",
            "text": "方向 B",
            "condition": {
              "type": "always"
            },
            "next_step": "step_test_end_001"
          },
          {
            "choice_id": "test_opt_c",
            "text": "方向 C",
            "condition": {
              "type": "always"
            },
            "next_step": "step_test_end_001"
          },
          {
            "choice_id": "test_opt_d",
            "text": "方向 D",
            "condition": {
              "type": "always"
            },
            "next_step": "step_test_end_001"
          }
        ]
      },
      "next_step": null,
      "is_save": false
    },
    {
      "step_id": "step_test_end_001",
