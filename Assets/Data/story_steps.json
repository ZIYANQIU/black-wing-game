      },
      "next_step": null,
      "is_save": false
    },
    {
      "step_id": "step_fork_inspect_middle_001",
      "type": "narration",
      "speaker_id": null,
      "text": "一块看上去有些年头的木板，上面歪歪扭扭地刻着3km。",
      "condition": {
        "type": "always"
      },
      "params": {},
      "next_step": "step_fork_inspect_middle_002",
      "is_save": false
    },
    {
      "step_id": "step_fork_inspect_middle_002",
