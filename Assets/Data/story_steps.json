        "flag_id": "flag_fork_middle_inspected"
      },
      "next_step": null,
      "is_save": false
    },
    {
      "step_id": "step_fork_inspect_bottom_001",
      "type": "narration",
      "speaker_id": null,
      "text": "一块看上去还算光洁的木板，上面的字迹似乎是漆写的，尚未剥落。3km。",
      "condition": {
        "type": "always"
      },
      "params": {},
      "next_step": "step_fork_inspect_bottom_002",
      "is_save": false
    },
    {
